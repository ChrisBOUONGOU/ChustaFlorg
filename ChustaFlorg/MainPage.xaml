<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChustaFlorg.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B0F17">
    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <Grid Grid.Row="0" Padding="18,12" BackgroundColor="#121A28"
              ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <HorizontalStackLayout Spacing="11" VerticalOptions="Center">
                <Border BackgroundColor="#7A1F3D" StrokeThickness="0"
                        StrokeShape="RoundRectangle 11" WidthRequest="40" HeightRequest="40">
                    <Label Text="C" FontSize="23" FontAttributes="Bold" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="CHUSTAFLORG" FontSize="15" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="STUDIO DE PRÉSENTATION" FontSize="9" CharacterSpacing="1.5" TextColor="#94A3B8"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                <Button Text="Ouvrir" Clicked="OnOpenClicked" Padding="12,8"
                        BackgroundColor="#202C40" TextColor="White" FontSize="12"/>
                <Button Text="Enregistrer" Clicked="OnSaveClicked" Padding="12,8"
                        BackgroundColor="#202C40" TextColor="White" FontSize="12"/>
                <Button Text="▶ Multi-écrans" Clicked="OnLiveClicked" Padding="13,8"
                        BackgroundColor="#7A1F3D" TextColor="White" FontAttributes="Bold" FontSize="12"/>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Orientation="Vertical">
        <Grid x:Name="Workspace" Padding="14"
              ColumnDefinitions="220,*,340" ColumnSpacing="12">
            <Border x:Name="PlaylistPanel" Grid.Column="0" BackgroundColor="#121A28"
                    Stroke="#263246" StrokeThickness="1" Padding="13"
                    StrokeShape="RoundRectangle 12">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10">
                    <Label Text="PLAN DU CULTE" TextColor="#D8B46A" FontSize="10"
                           FontAttributes="Bold" CharacterSpacing="1.4"/>
                    <Label Grid.Row="1" Text="Ma présentation" TextColor="White"
                           FontSize="17" FontAttributes="Bold"/>
                    <CollectionView x:Name="SlidesList" Grid.Row="2"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSlideSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#1A2435" Stroke="#334155"
                                        StrokeThickness="1" Padding="10" Margin="0,3"
                                        StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding Title}" TextColor="White"
                                               FontSize="13" FontAttributes="Bold"/>
                                        <Label Text="{Binding Body}" TextColor="#94A3B8"
                                               FontSize="10" MaxLines="2" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Grid.Row="3" Text="+ Ajouter une diapositive"
                            Clicked="OnAddSlideClicked" BackgroundColor="#202C40"
                            TextColor="White" FontSize="12" Padding="10,8"/>
                    <Button Grid.Row="4" Text="Supprimer la diapositive"
                            Clicked="OnDeleteSlideClicked" BackgroundColor="#30202A"
                            TextColor="#FCA5A5" FontSize="12" Padding="10,8"/>
                </Grid>
            </Border>

            <Border x:Name="PreviewPanel" Grid.Column="1" BackgroundColor="#111827"
                    Stroke="#263246" StrokeThickness="1" Padding="20"
                    StrokeShape="RoundRectangle 12">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="APERÇU DE LA DIAPOSITIVE" TextColor="#D8B46A"
                               FontSize="10" FontAttributes="Bold" CharacterSpacing="1.3"/>
                        <Label Grid.Column="1" Text="LOCAL" TextColor="#86EFAC"
                               FontSize="9" FontAttributes="Bold"/>
                    </Grid>
                    <Image x:Name="PreviewBackground" Grid.Row="1" Aspect="AspectFill" IsVisible="False" Opacity="0.55"/>
                    <VerticalStackLayout Grid.Row="1" Spacing="18"
                                         HorizontalOptions="Center" VerticalOptions="Center"
                                         MaximumWidthRequest="760">
                        <Label x:Name="PreviewTitle" Text="Bienvenue" TextColor="#D8B46A"
                               FontSize="23" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label x:Name="PreviewBody" Text="Votre présentation commence ici"
                               TextColor="White" FontSize="32" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="← Précédente" Clicked="OnPreviousClicked"
                                BackgroundColor="#202C40" TextColor="White" FontSize="12"/>
                        <Button Grid.Column="1" Text="Suivante →" Clicked="OnNextClicked"
                                BackgroundColor="#202C40" TextColor="White" FontSize="12"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="RightToolsPanel" Grid.Column="2" ColumnDefinitions="48,*" ColumnSpacing="0" BackgroundColor="#121A28">
                <Border Grid.Column="0" BackgroundColor="#0B0F17" Stroke="#263246" StrokeThickness="1" Padding="4" StrokeShape="RoundRectangle 10">
                    <VerticalStackLayout Spacing="7">
                        <Button Text="⚙" Clicked="OnToolPropertiesClicked" WidthRequest="38" HeightRequest="42" Padding="0" BackgroundColor="#263246" TextColor="#D8B46A" FontSize="19"/>
                        <Button Text="▣" Clicked="OnToolMediaClicked" WidthRequest="38" HeightRequest="42" Padding="0" BackgroundColor="#1A2435" TextColor="White" FontSize="19"/>
                        <Button Text="🎨" Clicked="OnToolThemesClicked" WidthRequest="38" HeightRequest="42" Padding="0" BackgroundColor="#1A2435" TextColor="White" FontSize="17"/>
                        <Button Text="♫" Clicked="OnToolLyricsClicked" WidthRequest="38" HeightRequest="42" Padding="0" BackgroundColor="#1A2435" TextColor="White" FontSize="21"/>
                        <Button Text="📖" Clicked="OnToolBibleClicked" WidthRequest="38" HeightRequest="42" Padding="0" BackgroundColor="#1A2435" TextColor="White" FontSize="17"/>
                        <Button Text="◉" Clicked="OnToolApplicationThemeClicked" WidthRequest="38" HeightRequest="42" Padding="0" BackgroundColor="#1A2435" TextColor="White" FontSize="19"/>
                        <Button Text="⌁" Clicked="OnToolRemoteClicked" WidthRequest="38" HeightRequest="42" Padding="0" BackgroundColor="#1A2435" TextColor="#86EFAC" FontSize="21"/>
                    </VerticalStackLayout>
                </Border>
                <Grid Grid.Column="1" Margin="9,0,0,0">
                    <Border x:Name="InspectorPanel" BackgroundColor="#121A28" Stroke="#263246" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                        <ScrollView><VerticalStackLayout Spacing="11">
                            <Label Text="PROPRIÉTÉS" TextColor="#D8B46A" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.4"/>
                            <Label Text="TITRE" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"/>
                            <Entry x:Name="TitleEditor" Placeholder="Titre de la diapositive" TextColor="White" PlaceholderColor="#64748B" BackgroundColor="#1A2435" TextChanged="OnEditorChanged"/>
                            <Label Text="CONTENU" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold"/>
                            <Editor x:Name="BodyEditor" Placeholder="Saisissez le texte à afficher…" TextColor="White" PlaceholderColor="#64748B" BackgroundColor="#1A2435" AutoSize="TextChanges" MinimumHeightRequest="210" TextChanged="OnEditorChanged"/>
                            <Label Text="CONSEIL" TextColor="#D8B46A" FontSize="10" FontAttributes="Bold"/>
                            <Label Text="Préparez et vérifiez vos diapositives avant de lancer la présentation." TextColor="#94A3B8" FontSize="11"/>
                            <Label x:Name="StatusLabel" Text="Prêt · Projet local" TextColor="#D8B46A" FontSize="11" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout></ScrollView>
                    </Border>
                    <Border x:Name="MediaPanel" IsVisible="False" BackgroundColor="#121A28" Stroke="#263246" StrokeThickness="1" Padding="12" StrokeShape="RoundRectangle 12">
                        <ScrollView>
                            <VerticalStackLayout Spacing="9">
                                <Label Text="MÉDIATHÈQUE" TextColor="#D8B46A" FontSize="10" FontAttributes="Bold"/>
                                <Entry x:Name="MediaSearchEntry" Placeholder="Rechercher un média..." TextChanged="OnMediaSearchChanged" TextColor="White" PlaceholderColor="#64748B" BackgroundColor="#1A2435"/>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                                    <Button Text="+ Image" Clicked="OnImportImageClicked" BackgroundColor="#263246" TextColor="White" FontSize="10" Padding="5"/>
                                    <Button Grid.Column="1" Text="+ Vidéo" Clicked="OnImportVideoClicked" BackgroundColor="#263246" TextColor="White" FontSize="10" Padding="5"/>
                                    <Button Grid.Column="2" Text="+ Audio" Clicked="OnImportAudioClicked" BackgroundColor="#263246" TextColor="White" FontSize="10" Padding="5"/>
                                </Grid>
                                <Label Text="FICHIERS" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold"/>
                                <CollectionView x:Name="MediaAssetsView" HeightRequest="220" SelectionMode="Single" SelectionChanged="OnMediaAssetSelected">
                                    <CollectionView.ItemTemplate><DataTemplate>
                                        <Border BackgroundColor="#1A2435" Stroke="#334155" StrokeThickness="1" Padding="9" Margin="0,3" StrokeShape="RoundRectangle 8">
                                            <Grid ColumnDefinitions="30,*,Auto">
                                                <Label Text="{Binding Icon}" FontSize="21" VerticalOptions="Center"/>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding Name}" TextColor="White" FontSize="11" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Kind}" TextColor="#94A3B8" FontSize="9"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="›" TextColor="#D8B46A" FontSize="20" VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></CollectionView.ItemTemplate>
                                </CollectionView>
                                <Label x:Name="MediaStatusLabel" Text="Aucun média sélectionné" TextColor="#94A3B8" FontSize="10"/>
                                <Button Text="Définir comme arrière-plan" Clicked="OnSetMediaBackgroundClicked" BackgroundColor="#7A1F3D" TextColor="White" FontSize="11" Padding="8"/>
                                <Button Text="Associer l'audio à la diapositive" Clicked="OnSetSlideAudioClicked" BackgroundColor="#263246" TextColor="White" FontSize="11" Padding="8"/>
                                <Button Text="Ouvrir le média" Clicked="OnOpenMediaClicked" BackgroundColor="#263246" TextColor="White" FontSize="11" Padding="8"/>
                                <Label Text="ARRIÈRE-PLAN" TextColor="#D8B46A" FontSize="9" FontAttributes="Bold"/>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                                    <Button Text="Nuit" Clicked="OnMediaBackgroundNightClicked" BackgroundColor="#111827" TextColor="White" FontSize="9" Padding="5"/>
                                    <Button Grid.Column="1" Text="Bordeaux" Clicked="OnMediaBackgroundBurgundyClicked" BackgroundColor="#5B1D35" TextColor="White" FontSize="9" Padding="5"/>
                                    <Button Grid.Column="2" Text="Forêt" Clicked="OnMediaBackgroundForestClicked" BackgroundColor="#164E3B" TextColor="White" FontSize="9" Padding="5"/>
                                    <Button Grid.Column="3" Text="Clair" Clicked="OnMediaBackgroundLightClicked" BackgroundColor="#F1F5F9" TextColor="#111827" FontSize="9" Padding="5"/>
                                </Grid>
                                <Label Text="TRANSITION" TextColor="#D8B46A" FontSize="9" FontAttributes="Bold"/>
                                <Picker x:Name="TransitionPicker" Title="Choisir une transition" TextColor="White" BackgroundColor="#1A2435">
                                    <Picker.Items><x:String>Aucune</x:String><x:String>Fondu</x:String><x:String>Glissement</x:String></Picker.Items>
                                </Picker>
                                <Button Text="Appliquer la transition" Clicked="OnApplyTransitionClicked" BackgroundColor="#263246" TextColor="White" FontSize="11" Padding="8"/>
                                <Button Text="Supprimer le média" Clicked="OnDeleteMediaClicked" BackgroundColor="#30202A" TextColor="#FCA5A5" FontSize="11" Padding="8"/>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>
                    <Border x:Name="ThemePanel" IsVisible="False" BackgroundColor="#121A28" Stroke="#263246" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="10"><Label Text="THÈMES DE DIAPOSITIVE" TextColor="#D8B46A" FontSize="10" FontAttributes="Bold"/>
                            <Button Text="Bleu nuit" Clicked="OnThemeNightClicked" BackgroundColor="#111827" TextColor="White"/>
                            <Button Text="Bordeaux" Clicked="OnThemeBurgundyClicked" BackgroundColor="#5B1D35" TextColor="White"/>
                            <Button Text="Vert forêt" Clicked="OnThemeForestClicked" BackgroundColor="#164E3B" TextColor="White"/>
                            <Button Text="Clair" Clicked="OnThemeLightClicked" BackgroundColor="#F1F5F9" TextColor="#111827"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border x:Name="LyricsPanel" IsVisible="False" BackgroundColor="#121A28" Stroke="#263246" StrokeThickness="1" Padding="8" StrokeShape="RoundRectangle 12"><ContentView x:Name="WorshipContentHost"/></Border>
                    <Border x:Name="BiblePanel" IsVisible="False" BackgroundColor="#121A28" Stroke="#263246" StrokeThickness="1" Padding="8" StrokeShape="RoundRectangle 12"><ContentView x:Name="BibleContentHost"/></Border>
                    <Border x:Name="RemotePanel" IsVisible="False" BackgroundColor="#121A28" Stroke="#263246" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                        <ScrollView><VerticalStackLayout Spacing="11">
                            <Label Text="TÉLÉCOMMANDE À DISTANCE" TextColor="#D8B46A" FontSize="10" FontAttributes="Bold"/>
                            <Label Text="ORDINATEUR HÔTE" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold"/>
                            <Button Text="Démarrer le serveur de télécommande" Clicked="OnStartRemoteHostClicked" BackgroundColor="#7A1F3D" TextColor="White" FontSize="11"/>
                            <Label x:Name="RemoteHostAddressLabel" Text="Serveur arrêté" TextColor="#86EFAC" FontSize="12"/>
                            <Label x:Name="RemotePinLabel" Text="Code : —" TextColor="#D8B46A" FontSize="15" FontAttributes="Bold"/>
                            <Button Text="Arrêter le serveur" Clicked="OnStopRemoteHostClicked" BackgroundColor="#30202A" TextColor="#FCA5A5" FontSize="11"/>
                            <BoxView HeightRequest="1" Color="#334155"/>
                            <Label Text="CONNECTER CE TÉLÉPHONE / CETTE TABLETTE" TextColor="#D8B46A" FontSize="9" FontAttributes="Bold"/>
                            <Entry x:Name="RemoteAddressEntry" Placeholder="Adresse de l'ordinateur (ex. 192.168.1.20)" Text="http://" TextColor="White" PlaceholderColor="#64748B" BackgroundColor="#1A2435"/>
                            <Entry x:Name="RemotePinEntry" Placeholder="Code PIN à 6 chiffres" Keyboard="Numeric" MaxLength="6" TextColor="White" PlaceholderColor="#64748B" BackgroundColor="#1A2435"/>
                            <Button Text="Se connecter" Clicked="OnConnectRemoteClicked" BackgroundColor="#263246" TextColor="White" FontSize="11"/>
                            <Label x:Name="RemoteConnectionStatusLabel" Text="Non connecté" TextColor="#94A3B8" FontSize="10"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="◀ PRÉCÉDENTE" Clicked="OnRemotePreviousClicked" BackgroundColor="#263246" TextColor="White" FontSize="12" HeightRequest="58"/>
                                <Button Grid.Column="1" Text="SUIVANTE ▶" Clicked="OnRemoteNextClicked" BackgroundColor="#7A1F3D" TextColor="White" FontSize="12" HeightRequest="58"/>
                            </Grid>
                            <Label x:Name="RemoteSlideStatusLabel" Text="Aucune présentation distante" TextColor="#D8B46A" FontSize="11"/>
                            <Label Text="Les appareils doivent être connectés au même réseau Wi-Fi. Saisissez l'adresse IP et le code affichés sur l'ordinateur hôte." TextColor="#94A3B8" FontSize="10"/>
                        </VerticalStackLayout></ScrollView>
                    </Border>
                    <Border x:Name="ApplicationThemePanel" IsVisible="False" BackgroundColor="#121A28" Stroke="#263246" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="10"><Label Text="APPARENCE" TextColor="#D8B46A" FontSize="10" FontAttributes="Bold"/>
                            <Button Text="Mode sombre" Clicked="OnDarkAppearanceClicked" BackgroundColor="#263246" TextColor="White"/>
                            <Button Text="Mode clair" Clicked="OnLightAppearanceClicked" BackgroundColor="#E2E8F0" TextColor="#111827"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>        </Grid>
        </ScrollView>
    </Grid>
</ContentPage>